%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2750553b975d35d4895ce7a0d64b4ae6, type: 3}
  m_Name: O_RR_12_QuizLinearTextData
  m_EditorClassIdentifier: 
  PopupType: 10
  InterruptsMovement: 1
  Title: Comunicare i risultati della ricerca
  TitleKey: 
  SubTitle: Seleziona la risposta corretta
  SubTitleKey: 
  Type: 0
  ProfilingData: {fileID: 0}
  Questions:
  - Image: {fileID: 21300000, guid: 51009c8e4b56ede4fb34d062050c4d70, type: 3}
    Content:
      Type: 0
      Text: A quale pubblico possiamo comunicare i risultati della nostra ricerca?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "All\u2019ambito scientifico e a un pubblico virtuale."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Al solo ambito accademico.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "All\u2019ambito scientifico e a un pubblico generalista."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 51009c8e4b56ede4fb34d062050c4d70, type: 3}
    Content:
      Type: 0
      Text: Che tipo di pubblicazioni utilizza prevalentemente la comunicazione scientifica?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Scritti divulgativi e comunicazione verbale.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Monografie, atti di convegni, report istituzionali.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Podcast.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 894d9022f058df04191771435e7a7943, type: 3}
    Content:
      Type: 0
      Text: Quali tecniche di base utilizzi per scrivere un testo scientifico?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Il riassunto.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "L\u2019impaginazione tipografica."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "La nota a pi\xE8 di pagina e il riferimento bibliografico."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 51009c8e4b56ede4fb34d062050c4d70, type: 3}
    Content:
      Type: 0
      Text: "Quali sono le finalit\xE0 di uno stile di scrittura scientifico?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Evidenziare l\u2019originalit\xE0 delle idee contenute nel testo."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Affascinare  il lettore con uno stile convincente.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Provare le affermazioni contenute nel testo con dati e citazioni bibliografiche.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 8039955c5f983e14b81448fbf02857f1, type: 3}
    Content:
      Type: 0
      Text: "Come riferiamo il pensiero di un altro autore all\u2019interno di un
        nostro testo?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Elaborando il testo originale per inglobarlo nel nostro testo.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Citando il testo originale e concludendo la citazione con una nota
          bibliografica a pi\xE8 di pagina."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Citando il testo originale in una nota che pu\xF2 essere anche molto
          lunga."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 04e4eb5effd884944a2e6b53110a1264, type: 3}
    Content:
      Type: 0
      Text: "La nota a pi\xE8 di pagina \xE8 una tecnica:"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Tipica delle pubblicazioni cartacee.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Utilizzata in pubblicazioni cartacee e in Internet.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Usata per i testi scritti e per i file audio.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 843497a00e79be3448f6201256f4563c, type: 3}
    Content:
      Type: 0
      Text: "La nota a pi\xE9 di pagina si utilizza solitamente:"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Per lunghe digressioni che non riusciamo ad inserire nel discorso principale.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Inserendola nella pagina successiva a quella del testo.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Al fondo della stessa pagina in cui si trova il testo cui la nota si
          riferisce.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 8d39ebc74f8baf045b38a305419ace3c, type: 3}
    Content:
      Type: 0
      Text: "Qual \xE8 il fine principale di una didascalia?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Stabilire una relazione di verit\xE0 tra un originale fisico e una
          sua riproduzione presente in una pubblicazione."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Descrivere dettagliatamente l\u2019oggetto raffigurato."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Citare l\u2019autore dell\u2019immagine."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 8d39ebc74f8baf045b38a305419ace3c, type: 3}
    Content:
      Type: 0
      Text: 'La didascalia si introduce quando:'
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "L\u2019immagine cui si riferisce la didascalia raffigura un\u2019opera
          d\u2019arte."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Il contenuto dell\u2019immagine pubblicata non \xE8 chiaramente visibile."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Si inserisce un\u2019immagine all\u2019interno di un testo ovunque
          pubblicato."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 1654278cdcaffc44d95f03753ec0e08d, type: 3}
    Content:
      Type: 0
      Text: Quanti e quali piani concorrono a definire un riferimento bibliografico?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Il piano \xE8 unico ed \xE8 relativo alla struttura formale del riferimento."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Vi sono due piani: il primo relativo alla struttura, il secondo \xE8
          relativo alla forma e alle convenzioni grafiche."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: I tre piani esistenti sono relativi alla struttura, alle convenzioni
          formali, alle sigle e alle abbreviazioni utilizzate.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 1654278cdcaffc44d95f03753ec0e08d, type: 3}
    Content:
      Type: 0
      Text: Abbiamo dei modelli, dei punti di riferimento per studiare i riferimenti
        bibliografici?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Si, le norme redazionali di una casa editrice italiana.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Si, le norme catalografiche del Servizio Bibliotecario Nazionale (SBN-Opac).
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Si, le norme redatte dall\u2019ente o istituzione per il quale stiamo
          scrivendo il nostro testo."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 1654278cdcaffc44d95f03753ec0e08d, type: 3}
    Content:
      Type: 0
      Text: 'Per utilizzare correttamente una norma dobbiamo:'
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Applicarla in tutto il testo in maniera costante e coerente.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Tenerla a portata di mano e consultarla finch\xE9 non la conosciamo
          a memoria."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Verificare che tutti i riferimenti bibliografici siano corretti prima
          di licenziare il nostro un testo.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 841dd3a4f596d9f4baaadabeaa44b104, type: 3}
    Content:
      Type: 0
      Text: Possiamo indurre da un caso particolare una norma generale?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: No, non possiamo farlo.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "S\xEC, possiamo farlo, ma solo in certi casi."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "S\xEC, possiamo farlo."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 841dd3a4f596d9f4baaadabeaa44b104, type: 3}
    Content:
      Type: 0
      Text: "Quale vantaggio abbiamo dal formarci un\u2019idea generale della struttura
        di un riferimento bibliografico? "
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "All\u2019ambito scientifico e a un pubblico virtuale."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Al solo ambito accademico.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "All\u2019ambito scientifico e a un pubblico generalista."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 51009c8e4b56ede4fb34d062050c4d70, type: 3}
    Content:
      Type: 0
      Text: A quale pubblico possiamo comunicare i risultati della nostra ricerca?
