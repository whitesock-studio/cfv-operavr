MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2750553b975d35d4895ce7a0d64b4ae6, type: 3}
  m_Name: O_PR_20_QuizLinearTextData
  m_EditorClassIdentifier: 
  PopupType: 10
  InterruptsMovement: 1
  Title: L'organo di legno
  TitleKey: 
  SubTitle: "Sonorit\xE0 e associazione simbolica dell'organo di legno"
  SubTitleKey: 
  Type: 0
  ProfilingData: {fileID: 0}
  Questions:
  - Image: {fileID: 21300000, guid: 94c2483e83a5df340a14d10d2893605d, type: 3}
    Content:
      Type: 0
      Text: "Nella guida hai ricevuto alcune informazioni relative alla struttura
        organologica di questo strumento. Quale delle seguenti affermazioni \xE8
        corretta?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "L\u2019organo di legno \xE8 costituito dalla compresenza di canne 
          lignee e metalliche, che producono un suono penetrante"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Le canne di legno dell\u2019organo di legno danno vita ad un suono 
          avvolgente e intimo"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Gli attuali organari ritengono che ricostruire oggigiorno un organo 
          di legno che produca la stessa sonorit\xE0 del 1600 non sia possibile"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 94c2483e83a5df340a14d10d2893605d, type: 3}
    Content:
      Type: 0
      Text: "Hai ascoltato alcune sezioni musicali introdotte dal suono dell'organo
        di legno. Ricordi in quale delle seguenti sezioni il canto a solo \xE8 accompagnato
        dall\u2019organo di legno?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "In \u201CPossente spirto e formidabil nume\u201D"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "In \u201CPerch\u2019 a lo sdegno e al dolor in preda\u201D"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "In \u201CSignor, quel infelice\u201D"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 94c2483e83a5df340a14d10d2893605d, type: 3}
    Content:
      Type: 0
      Text: "Nell\u2019Orfeo, quando \u201Cinterviene\u201D l\u2019organo di legno
        possono essere compresenti anche altri strumenti che suonano insieme ad esso,
        ma talvolta \xE8 prescritto l\u2019uso del solo organo di legno: ricordi,
        ad esempio, in quale dei seguenti brani solistici?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "In \u201CNulla impresa per huom si tenta invano\u201D"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "In \u201CEi dorme, e la mia cetra\u201D"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "In \u201CTu se\u2019 morta\u201D"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
