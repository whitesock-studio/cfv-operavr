  Questions:
  - Image: {fileID: 21300000, guid: 770045a795d184e45a9c39ffd69fb719, type: 3}
    Content:
      Type: 0
      Text: La Lotta di Ercole con Acheloo - Scena III da batt. 51 a 56. Nella sezione
        proposta, quale parola di Deianira viene messa in evidenza dalla musica?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Addolcisci
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Cuore
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: 'Velen '
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 770045a795d184e45a9c39ffd69fb719, type: 3}
    Content:
      Type: 0
      Text: La Lotta di Ercole con Acheloo - Scena I da batt. 42 a 56. Nella sezione
        proposta, quale elemento arricchisce il significato delle parole "piangerei,
        piangere"?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Modulazioni repentine
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Melodia cantabile e tendenzialmente discendente
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: 'Linea vocale ricca di salti melodici '
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 770045a795d184e45a9c39ffd69fb719, type: 3}
    Content:
      Type: 0
      Text: "La Lotta di Ercole con Acheloo - Scena VIII da batt. 1 a 45. Nel recitativo
        proposto, quale di queste affermazioni \xE8 vera?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Il recitativo ha la stessa impostazione ritmico-declamatoria
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Il ritmo del recitativo varia in relazione all'affetto della parola
          cantata
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "\xC8 un recitativo accompagnato"
