        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "la clava l\u2019attributo di Ercole e la faretra di Acheloo"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: e53785e350923fc4fb73750ef115541f, type: 3}
    Content:
      Type: 0
      Text: Cosa vuole mettere in luce lo scultore?
