  Questions:
  - Image: {fileID: 21300000, guid: d1723aed8ce853c42932125eab32949b, type: 3}
    Content:
      Type: 0
      Text: "Perch\xE9 Acheloo si trasforma in serpente? "
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Perch\xE9 sa che Ercole teme i serpenti"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Perch\xE9 pensa in questo modo di poter vincere Ercole"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Perch\xE9 ricorda che Ercole era stato battuto da un grosso serpente"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 67a677a9345f6d4429717a9cf90805cd, type: 3}
    Content:
      Type: 0
      Text: 'La clava e la faretra accanto ai due uomini sono:'
