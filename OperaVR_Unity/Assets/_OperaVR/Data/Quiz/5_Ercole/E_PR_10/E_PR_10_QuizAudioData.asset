  Title: "La vocalit\xE0 agile "
  TitleKey: 
  SubTitle: 'Il timbro vocale dei falsettisti di oggi '
  SubTitleKey: 
  Type: 0
  ProfilingData: {fileID: 0}
  Questions:
  - Image: {fileID: 21300000, guid: ee3520ea1605e3344bd5b82ef5a783bf, type: 3}
    Content:
      Type: 0
      Text: "La scuola di canto odierna ha permesso ai controtenori di raggiungere
        un altissimo livello tecnico. Ascolta bene questi tre file in cui i tre interpreti
        cantano l'incipit di una famosa aria. Solo uno \xE8 un falsettista, sai dirmi
        quale?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 1
        Text: 
        AudioClip: {fileID: 8300000, guid: b36679f75a0a99d4aa877576685d42a7, type: 3}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
