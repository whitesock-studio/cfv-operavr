%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2750553b975d35d4895ce7a0d64b4ae6, type: 3}
  m_Name: OK_PR_26_QuizLinearTextData
  m_EditorClassIdentifier: 
  PopupType: 10
  InterruptsMovement: 1
  Title: Funzione dei cori nell'Orfeo
  TitleKey: 
  SubTitle: Il coro come personaggio collettivo del dramma in musica
  SubTitleKey: 
  Type: 0
  ProfilingData: {fileID: 0}
  Questions:
  - Image: {fileID: 21300000, guid: a3de013ccbac67441a3b0c62fe9856c0, type: 3}
    Content:
      Type: 0
      Text: "I cori dell'Orfeo si distinguono per la variet\xE0 della loro tecnica
        compositiva. Nell'Orfeo di Claudio Monteverdi, il coro che chiude il IV atto:"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Rimprovera Orfeo per aver disobbedito a Plutone
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Ha una struttura polifonica a 5 voci
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "\xC8 omoritmico e omofonico"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: a3de013ccbac67441a3b0c62fe9856c0, type: 3}
    Content:
      Type: 0
      Text: "Tra i passi pi\xF9 celebri dell'Orfeo, vi \xE8 anche \"Ahi, caso acerbo!\"
        . Sai riconoscere che cosa esso sia:"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Un coro cantato dagli Spiriti infernali nel III atto
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Non \xE8 un coro, ma un brano a solo cantato dalla Messaggera "
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "\xC8 un coro composto da Ninfe e Pastori"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: a3de013ccbac67441a3b0c62fe9856c0, type: 3}
    Content:
      Type: 0
      Text: 'I cori che chiudono il III e il IV atto sono cori di spiriti che mirano
        a trasmettere l''atmosfera di gravitas oltretombale. Seleziona l''affermazione
        corretta a proposito di tale gravitas:'
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Viene espressa dal compositore anche attraverso la scelta delle voci
          che cantano \"Nulla impresa per uom si tenta invano\" e \"\xC8 la virtute
          un raggio\""
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Viene resa attraverso l\u2019assenza dell\u2019accompagnamento strumentale"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Si ottiene attraverso una dilatazione estrema dell\u2019andamento
          musicale"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
