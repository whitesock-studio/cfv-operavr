  - Image: {fileID: 21300000, guid: a177b52650b3df541b5b0fe15b5080f1, type: 3}
    Content:
      Type: 0
      Text: "Sai dire quali, tra le seguenti opere, sono esempi di fonti secondarie
        dedicate alla didattica e all\u2019ascolto del melodramma? "
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 3
    Choices:
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: "P. Fabbri, \u201CPossente spirto e formidabil nume\u201D, in Musica
          e Poesia son due sorelle (FrancoAngeli, 2022)"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: "G.B. Rinuccini, testo originale dell\u2019Euridice (1600)"
        AudioClip: {fileID: 0}
