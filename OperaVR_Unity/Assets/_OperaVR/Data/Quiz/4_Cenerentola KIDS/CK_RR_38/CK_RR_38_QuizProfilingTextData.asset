        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: a177b52650b3df541b5b0fe15b5080f1, type: 3}
    Content:
      Type: 0
      Text: "Secondo te, per indagare l\u2019autorialit\xE0 del finale apollineo
