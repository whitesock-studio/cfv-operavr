--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2750553b975d35d4895ce7a0d64b4ae6, type: 3}
  m_Name: CK_RR_38_QuizProfilingTextData
  m_EditorClassIdentifier: 
  PopupType: 0
  InterruptsMovement: 1
  Title: La storia e l'arte del balletto
  TitleKey: 
  SubTitle: 
  SubTitleKey: 
  Type: 1
  ProfilingData: {fileID: 11400000, guid: 20f16d7fe60679640b3910faa43fe9c4, type: 2}
  Questions:
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: In quale periodo Prokof'ev compose la musica di Cenerentola?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: Tra il 1940 e il 1944, durante la Seconda guerra mondiale
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Durante il Rinascimento italiano
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Nel pieno Settecento
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: All'inizio degli anni Duemila
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: Dove e in che anno avvenne la prima mondiale del balletto Cenerentola?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: "Nel 1945, al Teatro Bol'\u0161oj di Mosca"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: "Nel 1815, all'Op\xE9ra di Parigi"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Nel 1990, al Teatro alla Scala di Milano
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Nel 1700, a Londra
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: Quali affermazioni sul contesto in cui nacque Cenerentola sono corrette?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 2
    Choices:
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: "Prokof'ev la compose pur nell'oscurit\xE0 della guerra, trovandovi
          speranza e bellezza"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: La prima fu un momento culturale trionfale nella Russia del dopoguerra
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Fu composta in un lungo periodo di pace e spensieratezza
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: "Debutt\xF2 diversi secoli prima della nascita di Prokof'ev"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: "La prima pass\xF2 del tutto inosservata e senza importanza"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: Che cosa richiede mettere in scena una produzione di Cenerentola?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: Anni di allenamento dei ballerini e un'eccezionale collaborazione umana
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Un solo giorno di prove e nessuna preparazione
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Un unico ballerino che interpreta tutti i ruoli
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Soltanto effetti speciali, senza interpreti
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: Nel percorso vengono descritte le esigenze dei ruoli principali. Quali
        abbinamenti ruolo-caratteristica sono corretti?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 3
    Choices:
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: "Cenerentola: rappresentare insieme vulnerabilit\xE0 e forza"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: 'Le sorellastre: unire tempi comici e precisione fisica'
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: 'Il Principe: essere un partner forte e insieme un artista espressivo'
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: 'Cenerentola: eseguire soltanto gag comiche'
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: 'Il Principe: restare immobile per tutto il balletto'
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: "Le sorellastre: non richiedere alcuna abilit\xE0 particolare"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: Quali dettagli sul mestiere degli interpreti sono corretti?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 3
    Choices:
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: Le sorellastre sono spesso interpretate da ballerini uomini
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: Il Principe solleva e sostiene la partner mentre racconta la propria
          storia
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 1
      Content:
        Type: 0
        Text: Interpretare bene questi ruoli richiede grande dedizione
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Cenerentola deve perdere del tutto il 'gentile spirito' del personaggio
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: I ballerini raggiungono il livello richiesto senza alcun allenamento
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: "Quale celebre produzione, nel 1948, port\xF2 Cenerentola al successo
        internazionale?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: La produzione di Frederick Ashton
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Una produzione cinematografica di Hollywood
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: La prima produzione televisiva italiana
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Una produzione del Settecento francese
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: "Che cosa possiamo affermare sull'eredit\xE0 di Cenerentola dal debutto
        a oggi?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 2
    Choices:
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: "\xC8 diventato uno dei lavori di balletto pi\xF9 duraturi e amati"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: Ancora oggi le compagnie di tutto il mondo lo reinterpretano per le
          nuove generazioni
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: "Non viene pi\xF9 rappresentato da decenni"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: "\xC8 rimasto legato a un unico teatro, senza mai uscirne"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Fu dimenticato subito dopo la guerra
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: Quali tappe della storia del balletto sono riportate correttamente?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 2
    Choices:
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: "Dal debutto in tempo di guerra \xE8 arrivato ai palcoscenici di tutto
          il mondo"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: "La produzione di Ashton del 1948 lo apr\xEC a nuovi pubblici"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: "Nel 1945 era gi\xE0 celebre in tutti i continenti"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: La sua prima produzione internazionale risale al Medioevo
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: "Dopo il 1948 non \xE8 pi\xF9 stato reinterpretato da nessuno"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: Come agisce la partitura di Cenerentola?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 2
    Choices:
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: Unisce il fantastico e il lirico, facendo sembrare reale la magia
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: Fa 'danzare' le emozioni sul palco in movimenti grandiosi e intimi
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Rende la musica un semplice sottofondo senza emozioni
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Serve solo a coprire i rumori del pubblico
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: Il balletto parla di 'speranze universali'. Quali sono, secondo il testo?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 3
    Choices:
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: Che la gentilezza venga premiata
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: Che la magia possa esistere in luoghi inaspettati
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: Che la trasformazione sia sempre possibile
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: "Che vinca sempre il pi\xF9 forte e il pi\xF9 ricco"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Che la magia non esista nella vita reale
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: "Perch\xE9 Cenerentola \xE8 adatto anche al pubblico pi\xF9 giovane?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 3
    Choices:
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: Introduce il vocabolario del balletto classico attraverso una storia
          amata e familiare
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: Racconta una storia senza tempo, che parla a speranze di tutti
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 1
      Content:
        Type: 0
        Text: "\xC8 una storia famosa e conosciuta da molti bambini"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: "Perch\xE9 non richiede alcuna attenzione n\xE9 ascolto"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: "Perch\xE9 dura solo pochi secondi"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
