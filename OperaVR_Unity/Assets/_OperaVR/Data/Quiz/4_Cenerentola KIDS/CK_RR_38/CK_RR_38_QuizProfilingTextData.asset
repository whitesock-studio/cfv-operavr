  - Image: {fileID: 21300000, guid: a177b52650b3df541b5b0fe15b5080f1, type: 3}
    Content:
      Type: 0
      Text: "Quali tra i seguenti materiali sono da considerarsi fonti primarie per
        lo studio de La Favola d\u2019Orfeo di Monteverdi e Striggio?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 2
    Choices:
