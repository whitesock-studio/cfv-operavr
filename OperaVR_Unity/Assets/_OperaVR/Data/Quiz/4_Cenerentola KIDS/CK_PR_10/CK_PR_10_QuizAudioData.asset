        AudioClip: {fileID: 8300000, guid: 62a37f60f35a4df429ba70378e379095, type: 3}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 6866db74cfee4bb4389ead351f3fb597, type: 3}
    Content:
      Type: 1
      Text: "La voce della Messaggera declama con intensa partecipazione emotiva
        la sofferenza per l\u2019evento nefasto che ha colpito Euridice. Quale di
        questi brani \xE8 cantato dalla Messaggera?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: "Questa \xE8 la risposta giusta, complimenti!"
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 1
        Text: 
        AudioClip: {fileID: 8300000, guid: 2d352f5ca9c8c3944ac3e7902817c695, type: 3}
        Image: {fileID: 0}
