  Questions:
  - Image: {fileID: 21300000, guid: 6866db74cfee4bb4389ead351f3fb597, type: 3}
    Content:
      Type: 0
      Text: "Il prologo che apre l\u2019Orfeo porta in scena la figura di Musica
        e torner\xE0 a suggellare altri momenti significativi lungo l\u2019opera.
        Riconosci quale di questi estratti audio corrisponde al ritornello che apre
        il Prologo? "
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: "Questa \xE8 la risposta giusta, complimenti!"
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 1
        Text: 
        AudioClip: {fileID: 8300000, guid: 8a26e884a628776498c63996faebd660, type: 3}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
