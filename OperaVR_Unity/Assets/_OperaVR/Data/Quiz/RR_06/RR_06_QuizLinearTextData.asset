%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2750553b975d35d4895ce7a0d64b4ae6, type: 3}
  m_Name: RR_06_QuizLinearTextData
  m_EditorClassIdentifier: 
  PopupType: 10
  InterruptsMovement: 1
  Title: Metodologia della ricerca
  TitleKey: 
  SubTitle: Seleziona la risposta corretta
  SubTitleKey: 
  Type: 0
  ProfilingData: {fileID: 0}
  Questions:
  - Image: {fileID: 21300000, guid: 9df1e3bd51e989842a8d13f0e79528b1, type: 3}
    Content:
      Type: 0
      Text: In cosa si distingue la ricerca a fine di studio dalle ricerche che facciamo
        nella vita quotidiana?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Quando studiamo consultiamo solo le risorse in Internet perch\xE9
          sono pi\xF9 aggiornate."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: La ricerca a fini di studio fa uso di risorse specializzate e di specifici
          metodi di ricerca.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: La ricerca a fini di studio non utilizza gli smartphone.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 9df1e3bd51e989842a8d13f0e79528b1, type: 3}
    Content:
      Type: 0
      Text: 'Che cosa significa dunque fare ricerca per studio? Significa:'
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: " Leggere tutto quanto \xE8 stato scritto prima di noi in relazione
          alla nostra domanda di ricerca."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Utilizzare tutte le informazioni che troviamo leggendo la letteratura.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Partire da una domanda di ricerca iniziale e approfondirla per ottenere
          dei risultati scientificamente validi.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: b4375e2abdb36b54cb53d5a455ca0811, type: 3}
    Content:
      Type: 0
      Text: In quali luoghi si conservano le fonti e le risorse di uso comune nella
        ricerca di ambito storico-artistico, in particolare musicale?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Nei Conservatori di musica italiani.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Nelle Universit\xE0 statali e non statali europee."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Nelle Biblioteche, negli Archivi e nei Musei del mondo.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: b4375e2abdb36b54cb53d5a455ca0811, type: 3}
    Content:
      Type: 0
      Text: "C\u2019\xE8 una relazione tra i luoghi di conservazione e Internet?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: No, le istituzioni non dispongono di strutture per pubblicare in Internet.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "S\xEC, gli istituti provvedono a digitalizzare i beni che custodiscono
          e a pubblicare le riproduzioni in rete."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "S\xEC, ma solo se le istituzioni dispongono in loco delle attrezzature
          necessarie a pubblicare in rete."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 77988920d1dbacf449a14348a0b2cc95, type: 3}
    Content:
      Type: 0
      Text: Che tipi di oggetti di carattere musicale conservano e digitalizzano
        i musei?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Ritratti dipinti, Strumenti musicali, Costumi di scena.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Stoffe e arazzi, Marmi, Strumenti musicali.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Dipinti ad olio, Costumi di scena, Statue.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 77988920d1dbacf449a14348a0b2cc95, type: 3}
    Content:
      Type: 0
      Text: Quali di queste tipologie di documenti sono conservati negli archivi?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Lettere, Registri amministrativi, Fotografie.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Atti notarili, Medaglie, Manifesti.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Targhe commemorative, Libri a stampa, Manifesti.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 77988920d1dbacf449a14348a0b2cc95, type: 3}
    Content:
      Type: 0
      Text: E quali di queste risorse sono conservate e valorizzate dalle biblioteche?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Codici manoscritti, Strumenti scientifici storici, Libretti d\u2019opera."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Dizionari,  Affreschi, Cartoline storiche.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Letteratura sulla musica, Documenti sonori e audiovisivi, Musica a
          stampa a e manoscritta.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 77988920d1dbacf449a14348a0b2cc95, type: 3}
    Content:
      Type: 0
      Text: Come distinguiamo le fonti che testimoniano e tramandano un evento musicale?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Fonti sonore, fonti scritte, fonti audiovisive.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Fonti a stampa, fonti manoscritte, fonti digitali.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Fonti della composizione, Fonti delle esecuzioni, Scritti sulla musica
          e sugli eventi musicali.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: a2c6e05c6c6f6024e8a581d25505df93, type: 3}
    Content:
      Type: 0
      Text: "Cosa intendiamo con l\u2019espressione \u201Cletteratura musicale\u201D?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: I romanzi e la poesia ambientati in contesti musicali.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "L\u2019insieme delle edizioni di musica a stampa."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Gli scritti che hanno per oggetto la musica e gli eventi musicali.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: dcfaa05e16aeb42438e123aca51776b0, type: 3}
    Content:
      Type: 0
      Text: "Qual \xE8 la principale differenza tra una pubblicazione a stampa e
        una pubblicazione digitale?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "La pubblicazione a stampa \xE8 definitiva, la pubblicazione online
          pu\xF2 cambiare nel tempo."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "La pubblicazione digitale pu\xF2 non avere un autore"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: La pubblicazione a stampa ha sempre un autore.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: dcfaa05e16aeb42438e123aca51776b0, type: 3}
    Content:
      Type: 0
      Text: "Il passaggio di una pubblicazione cartacea o analogica al formato digitale
        \xE8 uguale per tutte le tipologie di pubblicazione? "
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "S\xEC, per certo."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: No, per certo.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Probabilmente no.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: dcfaa05e16aeb42438e123aca51776b0, type: 3}
    Content:
      Type: 0
      Text: 'Prendiamo ad esempio il catalogo online di una biblioteca italiana.
        Oggi lo possiamo consultare:'
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Solo all\u2019interno della biblioteca a meno di non acquistarlo in
          abbonamento."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Da qualsiasi postazione collegata a Internet perch\xE9 \xE8 un catalogo
          ad accesso libero."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Solo in Italia, proprio perch\xE9 \xE8 di una biblioteca italiana."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: dcfaa05e16aeb42438e123aca51776b0, type: 3}
    Content:
      Type: 0
      Text: "Qual \xE8 la differenza tra una risorsa digitale e una risorsa digitalizzata?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Si dice digitalizzata una risorsa da scansionare.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Una risorsa digitalizzata \xE8 la riproduzione in formato digitale
          di una risorsa fisica; una risorsa \xE8 nativa digitale quando \xE8 nata
          in ambito digitale."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Una risorsa si dice digitale se \xE8 scritta in codice alfanumerico."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: bb805a240c047464d8a073b0fb76e728, type: 3}
    Content:
      Type: 0
      Text: "Qual \xE8 la differenza tra una bibliografia e un catalogo?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Un catalogo elenca solo delle risorse in vendita; una bibliografia
          elenca anche risorse gratuite.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Una bibliografia elenca e descrive delle risorse ma non \xE8 suo compito
          censire i luoghi che le posseggono, cosa che fa invece un catalogo."
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Una bibliografia include solo risorse selezionate in ambito internazonale
          mentre un catalogo di ambito internazionale le include tutte.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 5c9f5b40117cea54997da06e61c96fbf, type: 3}
    Content:
      Type: 0
      Text: "Quando \xE8 stato pubblicato per la prima volta il Dictionary of music
        and musicians - fondato dall\u2019ingegnere e musicologo britannico  Sir
        George Grove (1820\u20131900) - oggi noto come Grove music online?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Nel 1897.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Postumo nel 1910.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Nel 1879.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
