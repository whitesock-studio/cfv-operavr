        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 4ec7e4ebf888d0e44b83875f7ad3c578, type: 3}
    Content:
      Type: 0
      Text: 'Da questo frammento emerge chiaro un messaggio:'
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: I sogni rispecchiano i nostri desideri
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "L\u2019impossibile \xE8 impossibile"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "L\u2019impossibile \xE8 possibile"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 0a72d034e38a94a4da56fdcef5ae5ae3, type: 3}
