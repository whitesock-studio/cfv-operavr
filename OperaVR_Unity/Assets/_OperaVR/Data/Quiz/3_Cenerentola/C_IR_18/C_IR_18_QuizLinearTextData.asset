      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Una giovane donna determinata e ribelle
