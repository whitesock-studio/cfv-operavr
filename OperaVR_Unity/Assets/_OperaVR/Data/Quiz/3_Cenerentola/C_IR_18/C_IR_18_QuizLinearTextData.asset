  Questions:
  - Image: {fileID: 21300000, guid: 18bd61d7b2cf35a41876cd2db023e41f, type: 3}
    Content:
      Type: 0
      Text: 'In questa illustrazione possiamo osservare che:'
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: I personaggi sono molto curati ed espressivi
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: I volti dei personaggi sono poco curati
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Tutti i personaggi sono favorevolmente stupiti
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: cff728031e6bafe45a202f9662308017, type: 3}
    Content:
      Type: 0
      Text: "La fiaba di Cenerentola \xE8 ambientata a Londra:"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Ai nostri giorni
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Negli anni Venti
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Nell\u2019Ottocento"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: b9fc33568fa88104eb6417c5e553498b, type: 3}
    Content:
      Type: 0
      Text: Quali dei seguenti oggetti ci fanno capire che si tratta di Cenerentola?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Il vestito con le toppe e i piatti sullo sfondo
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: La zucca, il topolino e la scarpetta
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: La scarpetta, lo sguardo melanconico, la fata
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 2e01d3c9f46a16143bb73e7d7ff2920e, type: 3}
    Content:
      Type: 0
      Text: Cosa succede nella scena?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Al pranzo del principe Ramiro \xE8 arrivata una dama sconosciuta,
          Cenerentola"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Al pranzo del principe Ramiro non arriva Cenerentola
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Al pranzo del principe Ramiro tutti riconoscono che la dama velata
          \xE8 Cenerentola"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 43757b1272ec96f4282c46218e2b9c31, type: 3}
    Content:
      Type: 0
      Text: "La Cenerentola di Nureyev \xE8:"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Una giovane piena di fantasia
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Una giovane docile e passiva
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Una giovane annoiata
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 5a808ae02b55ddd40916debd8c4bc7d8, type: 3}
    Content:
      Type: 0
      Text: "Il balletto Cenerentola di Prokof\u2019ev si differenzia dalla fiaba
        di Perrault perch\xE9:"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "La Fata madrina \xE8 la madrina di Cenerentola"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "La Fata madrina \xE8 una mendicante"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "La Fata madrina \xE8 la zia di Cenerentola"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 726a11c10076a45479c16f3d2253035b, type: 3}
    Content:
      Type: 0
      Text: "Nel balletto Cenerentola di Prokof\u2019ev:"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Non si trova l\u2019albero magico"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Si trova l\u2019albero magico"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Dall\u2019albero magico scendono quattro fate"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 9a3bae1876ed58745a7f5b54a996ba80, type: 3}
    Content:
      Type: 0
      Text: 'Da questo frammento Cenerentola sembra:'
