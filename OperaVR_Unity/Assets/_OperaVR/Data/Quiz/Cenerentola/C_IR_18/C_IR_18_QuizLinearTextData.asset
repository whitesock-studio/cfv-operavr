  Questions:
  - Image: {fileID: 21300000, guid: f1c848ba16053a54091bc8c671ed1c4a, type: 3}
    Content:
      Type: 0
      Text: Da cosa capiamo che Orfeo ha appena infranto il divieto degli dei?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: "Questa \xE8 la risposta giusta, complimenti!"
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Orfeo ha smesso di suonare la lira
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Hermes la trattiene con la mano sinistra e Euridice ha il piede rivolto
          indietro
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Euridice appoggia con tenerezza una mano sulla spalla di Orfeo
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: c51e963ccfe033044a73d618089b79f0, type: 3}
    Content:
      Type: 0
      Text: "Il potere incantatorio della musica \xE8 evidenziato:"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: "Questa \xE8 la risposta giusta, complimenti!"
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: dalla definizione precisa delle corde della lira
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "dalla luminosit\xE0 della testa e dai guizzi luminosi sulle montagne"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "dall\u2019abbinamento della testa con la lira"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 5af19066c031e1d4f9fb9d3202a7f5d3, type: 3}
    Content:
      Type: 0
      Text: "Buzzati \xE8 fedele al mito?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: "Questa \xE8 la risposta giusta, complimenti!"
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Si, perch\xE9 Eura segue Orfi"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "No, perch\xE9 \xE8 Orfi a essere trascinato nel mondo dei vivi"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "No perch\xE9 Orfeo non si volta verso Euridice"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 450fd0c7d4ff0a7499c743447e1b3938, type: 3}
    Content:
      Type: 0
      Text: "Cosa ci fa capire che il cammino di Euridice \xE8 interrotto?"
