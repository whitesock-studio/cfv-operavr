    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Euridice \xE8 lontana da Orfeo"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Una mano afferra il suo braccio
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: 'Il volto di Euridice esprime turbamento '
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 43757b1272ec96f4282c46218e2b9c31, type: 3}
    Content:
      Type: 0
      Text: Cosa succede nelle due scene?
