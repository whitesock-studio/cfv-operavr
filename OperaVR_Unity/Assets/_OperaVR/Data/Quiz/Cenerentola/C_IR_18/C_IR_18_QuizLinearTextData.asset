    CorrectChoiceDescription: "Questa \xE8 la risposta giusta, complimenti!"
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Euridice \xE8 lontana da Orfeo"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Una mano afferra il suo braccio
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: 'Il volto di Euridice esprime turbamento '
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 6b0507faa51cefc4dad01c123f373abe, type: 3}
    Content:
      Type: 0
      Text: Cosa succede nelle due scene?
