        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "A sinistra Euridice \xE8 trattenuta da un serpente infernale e a destra
          sta seguendo Orfeo"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "A sinistra Euridice \xE8 morsa da un serpente e a destra Orfeo si
