  m_Script: {fileID: 11500000, guid: 2750553b975d35d4895ce7a0d64b4ae6, type: 3}
  m_Name: V_IR_30_QuizLinearTextData
  m_EditorClassIdentifier: 
  PopupType: 10
  InterruptsMovement: 1
  Title: Quiz Interdisciplinary Gallery secondo livello
  TitleKey: 
  SubTitle: Rispondi correttamente alle domande poste, 1 risposta corretta 2 errate
  SubTitleKey: 
  Type: 0
  ProfilingData: {fileID: 0}
  Questions:
  - Image: {fileID: 21300000, guid: a037c6ea6bc6bb34cae2c918b3e1d163, type: 3}
    Content:
      Type: 0
      Text: "Qual \xE8 l\u2019aspetto innovativo di 24 Hour Psycho di Douglas Gordon
        rispetto a Empire di Warhol?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Trasforma un film narrativo in pura esperienza temporale attraverso
          la dilatazione estrema
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Introduce il sonoro originale di Hitchcock sincronizzato con nuove
          immagini
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Usa l\u2019orologio reale come strumento di montaggio minuto per minuto"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 1346e9992a157114489f9762852e6912, type: 3}
    Content:
      Type: 0
      Text: "Che cosa mette in evidenza un\u2019opera come 48 War Movies di Christian
        Marclay, in cui decine di film scorrono simultaneamente?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "L\u2019inefficacia narrativa del linguaggio bellico e la sua saturazione
          mediatica"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "La possibilit\xE0 di restituire un unico racconto lineare della guerra
          attraverso frammenti"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "L\u2019interesse per i dettagli tecnici delle produzioni cinematografiche
          hollywoodiane"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 82afc1727db6d8942a50613cab6c6190, type: 3}
    Content:
      Type: 0
      Text: "In The Artist is Present, Marina Abramovi\u0107 trasforma un gesto minimo
        \u2013 lo sguardo \u2013 in opera.  Qual \xE8 il punto cruciale dell\u2019esperienza
        per lo spettatore?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "L\u2019illusione scenica di trovarsi di fronte a un personaggio teatrale"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "La relazione diretta e prolungata con il corpo dell\u2019artista come
          spazio di riflessione e vulnerabilit\xE0"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "L\u2019interpretazione drammatica di un testo recitato insieme al
          pubblico"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: a1e983cce98a5a14da97fa5ee6c00e36, type: 3}
    Content:
      Type: 0
      Text: In Datamatics di Ryoji Ikeda i dati vengono trasformati in sequenze audiovisive.
        Che cosa viene messo al centro del lavoro?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "La possibilit\xE0 di rendere percepibile l\u2019invisibile, trasformando
          il linguaggio astratto del codice in materia estetica"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: La traduzione fedele di database scientifici in grafici comprensibili
          al grande pubblico
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: La costruzione di un archivio storico audiovisivo accessibile tramite
          software interattivo
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 241d9a96c25ffad4da4eadd7bd907ee4, type: 3}
    Content:
      Type: 0
      Text: "Qual \xE8 l\u2019innovazione centrale del lavoro di John Cage e Merce
        Cunningham in How to Pass, Kick, Fall and Run?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "La perfetta sincronizzazione tra musica e coreografia per creare unit\xE0
          formale"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "L\u2019indipendenza reciproca di suono e movimento, che si incontrano
          solo nel tempo condiviso della performance"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "L\u2019uso esclusivo di strumenti elettronici per seguire i movimenti
          dei danzatori"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
