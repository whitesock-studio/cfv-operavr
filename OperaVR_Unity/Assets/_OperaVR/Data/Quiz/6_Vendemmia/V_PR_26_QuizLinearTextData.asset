  Title: Opera comica settecentesca
  TitleKey: 
  SubTitle: Basso buffo e aria di catalogo
  SubTitleKey: 
  Type: 0
  ProfilingData: {fileID: 0}
  Questions:
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: Quali delle seguenti caratteristiche non appartengono al basso buffo?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "La capacit\xE0 di sillabare e di cantare in velocit\xE0"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "L\u2019avere una voce estesa ed agile "
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Il possedere un forte registro acuto per melismi e coloriture
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: "Il basso buffo \xE8 un tipico personaggio:"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "dell\u2019opera comica"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "dell\u2019opera seria "
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "della trag\xE9die en musique francese"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: "Perch\xE9 l\u2019aria di catalogo viene definita cos\xEC?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Perch\xE9 le arie sono conservate all\u2019interno dei cataloghi delle
          biblioteche"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Perch\xE9 il cantante elenca tutta una serie di luoghi, persone o
          oggetti"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: In omaggio alla celebre aria di Leoporello nel Don Giovanni di Da Ponte-Mozart
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
