  m_EditorClassIdentifier: 
  PopupType: 10
  InterruptsMovement: 1
  Title: Quiz Interdisciplinary Gallery primo livello
  TitleKey: 
  SubTitle: Rispondi correttamente alle domande poste
  SubTitleKey: 
  Type: 0
  ProfilingData: {fileID: 0}
  Questions:
  - Image: {fileID: 21300000, guid: e0db8e0c80d82594989538a7fff1068f, type: 3}
    Content:
      Type: 0
      Text: "Quale tipo di amore \xE8 celebrato in questo sonetto?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Un amore raffinato  e appariscente
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Un amore intimo, profondamente radicato nell\u2019animo"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Un amore dettato dalle convenzioni sociali
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 121c6ddb3856f274a8bde6593528376b, type: 3}
    Content:
      Type: 0
      Text: "Perch\xE9 Elizabeth rifiuta la proposta di matrimonio?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Il signor Darcy si \xE8 accorto di lei troppo tardi"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Perch\xE9 appartengono a classi sociali differenti"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Il signor Darcy ribadisce l\u2019inferiorit\xE0 delle origini di Elizabeth"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: fba3f53100635fe4984e393b37a328d6, type: 3}
    Content:
      Type: 0
      Text: "Trovi che ci siano delle somiglianze di contenuto tra questo recitativo
        accompagnato e l\u2019aria del Marchese \"Su bel, bello, adagio, adagio\"
        de La vendemmia di Gazzaniga?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Si entrambi i personaggi esprimono il desiderio di unirsi all\u2019amata,
          nonostante la differenza di classe sociale"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Si, ma mentre il Marchese \xE8 certo dei suoi sentimenti, Uberto si
          sta ancora interrogando"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "No perch\xE9 Uberto, a differenza del Marchese, non \xE8 innamorato
          di Serpina"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: eefdfdf8e1a1be64b91fdd98f17a99c8, type: 3}
    Content:
      Type: 0
      Text: Con quali espedienti musicali Vivaldi ci trasmette il clima festoso e
        danzante?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Il modo maggiore e la ripetizione di cellule ritmico melodiche
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Il modo maggiore e l\u2019alternanza tra forti e piano"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Il modo maggiore e il dialogo tra solista e tutti
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: f247db7e9c2d08543a70f3d1ee08b945, type: 3}
    Content:
      Type: 0
      Text: "L\u2019allegria e la spensieratezza sono suggeriti:"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Dalla scena danzante
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Dalla danza e dalla musica
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Dal paesaggio luminoso sullo sfondo della scena
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: caea23d2e065861438850f7fcc4043b7, type: 3}
    Content:
      Type: 0
      Text: Da cosa possiamo intuire una condivisione tra nobili e contadini?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Il giovane nobile a destra festeggia con le due popolane
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: La coppia aristocratica con il bambino festeggia alla presenza di una
          giovane pastorella
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Il giovane nobile offre l\u2019uva alla pastorella"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: c270bfb643b97ec42930d1380da4af27, type: 3}
    Content:
      Type: 0
      Text: 'Pascoli in questa prima parte della poesia ci restituisce:'
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Un\u2019immagine onirica della vendemmia"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Un\u2019immagine quotidiana della vendemmia"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Un\u2019immagine concitata della vendemmia"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 467a591d7c3531b4f982e145543d4195, type: 3}
    Content:
      Type: 0
      Text: "L\u2019atmosfera festosa della vendemmia \xE8 trasmessa:"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Dai colori accesi e dai forti contrasti
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Dalle danze dei contadini
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Dalle espressioni dei contadini
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: f24f0b93815173b44b90b091bca88351, type: 3}
    Content:
      Type: 0
      Text: "In questo canto la vendemmia \xE8 sentita come un momento:"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Di lavoro faticoso accompagnato dalla musica
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Di socialit\xE0 e allegria"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Di immersione nella pace della natura
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
