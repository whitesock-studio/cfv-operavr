  Questions:
  - Image: {fileID: 21300000, guid: e0db8e0c80d82594989538a7fff1068f, type: 3}
    Content:
      Type: 0
      Text: Da cosa capiamo che Orfeo ha appena infranto il divieto degli dei?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Orfeo ha smesso di suonare la lira
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Hermes la trattiene con la mano sinistra e Euridice ha il piede rivolto
          indietro
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Euridice appoggia con tenerezza una mano sulla spalla di Orfeo
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: 121c6ddb3856f274a8bde6593528376b, type: 3}
    Content:
      Type: 0
      Text: "Il potere incantatorio della musica \xE8 evidenziato:"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: dalla definizione precisa delle corde della lira
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "dalla luminosit\xE0 della testa e dai guizzi luminosi sulle montagne"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "dall\u2019abbinamento della testa con la lira"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: fba3f53100635fe4984e393b37a328d6, type: 3}
    Content:
      Type: 0
      Text: "Buzzati \xE8 fedele al mito?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Si, perch\xE9 Eura segue Orfi"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "No, perch\xE9 \xE8 Orfi a essere trascinato nel mondo dei vivi"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "No perch\xE9 Orfeo non si volta verso Euridice"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: eefdfdf8e1a1be64b91fdd98f17a99c8, type: 3}
    Content:
      Type: 0
      Text: "Cosa ci fa capire che il cammino di Euridice \xE8 interrotto?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Euridice \xE8 lontana da Orfeo"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Una mano afferra il suo braccio
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: 'Il volto di Euridice esprime turbamento '
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: f247db7e9c2d08543a70f3d1ee08b945, type: 3}
    Content:
      Type: 0
      Text: Cosa succede nelle due scene?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "A sinistra Euridice \xE8 morsa da un drago e a destra Orfeo si \xE8
          voltato verso Euridice"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "A sinistra Euridice \xE8 trattenuta da un serpente infernale e a destra
          sta seguendo Orfeo"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: "A sinistra Euridice \xE8 morsa da un serpente e a destra Orfeo si
          \xE8 voltato verso Euridice"
