    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Euridice lo sta consolando
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 21300000, guid: c270bfb643b97ec42930d1380da4af27, type: 3}
