        Text: I manoscritti musicali giunti a noi.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: I testimoni musicali manoscritti e gli esemplari di libretti a stampa.
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
