  Questions:
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: CONTENUTI - All'interno del tessuto musicale operistico settecentesco
        vi sono diverse forme musicali con usi differenti. Come si definisce un'aria
        di presentazione?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Recitativo accompagnato
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Recitato semplice
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
