    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Negli intermezzi
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: "In \"Cos\xEC fan tutte\" di Da Ponte-Mozart il coro ha un ruolo:"
