    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Di contorno e di ambiente
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Drammaturgico e d\u2019ambiente"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Di contorno e di ambiente, eccetto che per il brano "Bella vita militar"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: "Solitamente nell\u2019opera comica il coro era costituito da:"
