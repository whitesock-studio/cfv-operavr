        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: "Qual \xE8 la regola centrale della \"Seconda Pratica\" sostenuta da
        Monteverdi?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 2
    Choices:
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: L'Armonia comanda sulla Parola
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: La Parola comanda sull'Armonia
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Il dissonante \xE8 sempre un errore matematico"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 1
      Content:
        Type: 0
        Text: La musica deve seguire la perfezione della polifonia fiamminga
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: "Quale madrigale scaten\xF2 uno scandalo perch\xE9 Monteverdi us\xF2
        dissonanze \"illegali\" per esprimere il dolore?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 2
    Choices:
    - IsCorrect: 0
      PointsGiven: 1
      Content:
        Type: 0
        Text: Lamento d'Arianna
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Madrigali guerrieri, et amorosi
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: Cruda Amarilli
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Zefiro torna
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: "Quale invenzione strumentale forn\xEC il fondamento armonico continuo
        per il solista?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 2
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
