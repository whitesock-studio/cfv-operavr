      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 2
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Venezia
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: Mantova
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 1
