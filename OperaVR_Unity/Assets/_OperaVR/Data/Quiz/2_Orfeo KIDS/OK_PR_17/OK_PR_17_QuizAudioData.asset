  Type: 0
  ProfilingData: {fileID: 0}
  Questions:
  - Image: {fileID: 21300000, guid: 936325b981e7f704687df6bca5701fc5, type: 3}
    Content:
      Type: 0
      Text: "Nell'Orfeo di Monteverdi la musica diventa un linguaggio delle emozioni:
        ogni svolta melodica, ogni colore vocale e ogni pausa espressiva ha significato.
        I compositori del primo Barocco usavano tono, tempo e timbro per \"codificare\"
        i sentimenti direttamente nel suono, permettendo all'ascoltatore di percepire
        l'emitivit\xE0 del dramma piuttosto che limitarsi a comprenderlo. Quale dei
        seguenti estratti audio esprime la tristezza pi\xF9 profonda e il maggior
        peso emotivo?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
