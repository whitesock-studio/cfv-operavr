      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 1
      PointsGiven: 0
      Content:
        Type: 0
        Text: Dei passi lenti e leggeri
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Un suono brillante di campane
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Dei colpi forti di tamburo
