  m_Name: OK_RR_38_QuizProfilingTextData
  m_EditorClassIdentifier: 
  PopupType: 0
  InterruptsMovement: 1
  Title: Voci di Emozione
  TitleKey: 
  SubTitle: Le Donne nelle Opere di Monteverdi
  SubTitleKey: 
  Type: 1
  ProfilingData: {fileID: 11400000, guid: 9d121712d1f6f49408918d3f472f3d0f, type: 2}
  Questions:
  - Image: {fileID: 21300000, guid: 835d1b87f32862f4494d2e185a3595ca, type: 3}
    Content:
      Type: 0
      Text: "Qual \xE8 la missione principale del personaggio \"La Musica\" nel Prologo
        dell'Orfeo?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: Imporre il silenzio e calmare ogni "turbato core" con "dolci accenti"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Mostrare la sua virtuosit\xE0 vocale"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: "Avvertire Orfeo che fallir\xE0 negli Inferi"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 1
      Content:
        Type: 0
        Text: Stabilire l'atmosfera emotiva per l'intero universo
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: Come si comporta Speranza quando arriva alle porte degli Inferi?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Entra con Orfeo per combattere Ade
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: "Deve andarsene, perch\xE9 sulla porta \xE8 scritto \"lasciate ogni
          speranza\""
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Resta a confortare Orfeo fino alla fine
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 1
      Content:
        Type: 0
        Text: Rappresenta il limite del conforto umano di fronte alla morte
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: A cosa serve la tecnica del "Recitativo" usata per Penelope ne "Il Ritorno
        d'Ulisse in Patria"?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: A creare una melodia orecchiabile e allegra
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 1
      Content:
        Type: 0
        Text: A esprimere la stanchezza di chi ha aspettato per 20 anni
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "A mostrare che \xE8 un personaggio molto felice"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: A far suonare la musica come un discorso onesto, crudo o come un pianto
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: "Perch\xE9 Poppea \xE8 considerata un \"Paradosso\" nella musica di Monteverdi?"
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: "Perch\xE9 \xE8 ambiziosa e \"malvagia\", ma ha la musica pi\xF9 bella
          e sensuale"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 1
      Content:
        Type: 0
        Text: "Perch\xE9 Monteverdi usa la sua musica per farci \"innamorare del
          cattivo\""
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: "Perch\xE9 \xE8 un'eroina che salva tutti"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: "Perch\xE9 non canta affatto"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
  - Image: {fileID: 0}
    Content:
      Type: 0
      Text: Quale emozione esprime la regina Ottavia in "Disprezzata Regina"?
      AudioClip: {fileID: 0}
      Image: {fileID: 0}
    CorrectChoiceDescription: Corretto!
    MaxChoices: 1
    Choices:
    - IsCorrect: 0
      PointsGiven: 0
      Content:
        Type: 0
        Text: Pura gioia e celebrazione
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 2
      Content:
        Type: 0
        Text: Uno sfogo musicale di rabbia per essere stata disprezzata
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: -1
      Content:
        Type: 0
        Text: Perdono verso Nerone e Poppea
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
    - IsCorrect: 0
      PointsGiven: 1
      Content:
        Type: 0
        Text: "Il dolore profondo di una donna che perde potere e dignit\xE0"
        AudioClip: {fileID: 0}
        Image: {fileID: 0}
